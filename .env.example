# Copy to .env and fill in. .env is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────
# The model brain + MCP connection live in the DSH harness now, so no model
# provider keys are needed here. This repo's runtime only needs Alpaca creds.
# ─────────────────────────────────────────────────────────────────────

# ─── Alpaca (paper trading + market data) ───
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── Agent loop / state (optional overrides) ───
# AGENT_STATE_PATH=state/state.json
# AGENT_LEDGER_PATH=state/ledger.jsonl
# DAY_PNL_PCT=0        # feed the day's P&L % into the risk gate for a cycle
